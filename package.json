{
  "name": "@eduardbar/drift",
  "version": "1.1.0",
  "description": "Detect silent technical debt left by AI-generated code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "drift": "bin/drift.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "vibe-coding",
    "technical-debt",
    "ai",
    "cli",
    "typescript",
    "static-analysis"
  ],
  "author": "eduardbar",
  "license": "MIT",
  "homepage": "https://github.com/eduardbar/drift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardbar/drift.git"
  },
  "bugs": {
    "url": "https://github.com/eduardbar/drift/issues"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "kleur": "^4.1.5",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
